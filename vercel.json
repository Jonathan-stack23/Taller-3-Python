{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.py": {
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/index.py" },
        { "source": "/(.*)", "destination": "/public/$1" }
    ]
}
